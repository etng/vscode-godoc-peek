{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "outDir": "out",
    "lib": ["es2020"],
    "sourceMap": true,
    "rootDir": "src",
    "types": ["node", "vscode"],
    "skipLibCheck": true,
    /* Strict Type-Checking Option */
    "strict": true /* enable all type-checking options */,
    /* Additional Checks */
    "noUnusedLocals": true /* Report errors on unused locals. */
  },
  "exclude": ["node_modules", ".vscode-test"]
}
